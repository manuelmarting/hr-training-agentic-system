APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]

# LLM provider selection: "gemini" (default), "anthropic", or "openai"
LLM_PROVIDER=gemini

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Voice output (voice-service/, Kokoro TTS). Best-effort: chat still works text-only
# if this is unreachable. Docker Compose overrides this to http://voice:8001.
KOKORO_SERVICE_URL=http://localhost:8001
